<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  controllerName="com.sap.usetax.intelligenceui5.controller.App"
  displayBlock="true">
  <Page title="{i18n>appTitle}">
    <headerContent>
      <Button text="Vendor Dashboard" icon="sap-icon://business-objects-experience" press="onOpenVendors"/>
    </headerContent>
    <content>
      <l:Splitter height="100%">
        <VBox width="350px">
          <SearchField placeholder="Search supplier or file..." liveChange="onSearchInvoices"/>
          <List id="invoiceList" headerText="Invoices" busy="{/busy}" items="{/invoices}">
            <StandardListItem title="{supplierName}" description="{fileName}" info="{scnid}" type="Active" press="onInvoicePress"/>
          </List>
        </VBox>
        <VBox class="sapUiMediumMargin">
  <ObjectHeader title="{/selected/supplierName}" number="{/selected/scnid}"/>

  <BusyIndicator visible="{/extracting}" class="sapUiMediumMargin"/>

  <VBox visible="{= !!${/extracted} }">
    <Title text="General Information" class="sapUiSmallMarginTop"/>
    <Label text="Vendor Name"/>
    <Text text="{/extracted/vendorName}"/>
    <Label text="Invoice Number" class="sapUiSmallMarginTop"/>
    <Text text="{/extracted/invoiceNumber}"/>
    <Label text="Document Date" class="sapUiSmallMarginTop"/>
    <Text text="{/extracted/documentDate}"/>
    <Label text="Ship To" class="sapUiSmallMarginTop"/>
    <Text text="{/extracted/shipToCity} {/extracted/shipToState} {/extracted/shipToPostalCode}"/>
    <Label text="Gross Amount" class="sapUiSmallMarginTop"/>
    <Text text="{/extracted/grossAmount}"/>
    <Label text="Tax Amount" class="sapUiSmallMarginTop"/>
    <Text text="{/extracted/taxAmount}"/>
  </VBox>
</VBox>
      </l:Splitter>
    </content>
  </Page>
</mvc:View>