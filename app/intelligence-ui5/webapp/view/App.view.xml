<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  controllerName="com.sap.usetax.intelligenceui5.controller.App"
  displayBlock="true">
  <App id="app">
    <pages>
      <Page title="{i18n>appTitle}" showNavButton="false">
        <content>
          <MessagePage
            showHeader="false"
            text="{i18n>appTitle}"
            description="{i18n>shellReadyMessage}"
            icon="sap-icon://tax-declaration"/>
        </content>
      </Page>
    </pages>
  </App>
</mvc:View>
